<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Field background colors matching VBA form -->
    <SolidColorBrush x:Key="InputBrush"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CalcBrush"     Color="#F2F3F4"/>
    <SolidColorBrush x:Key="LockedBrush"   Color="#E0E0E0"/>
    <SolidColorBrush x:Key="GroupBorder"   Color="#AAAAAA"/>
    <SolidColorBrush x:Key="GroupHeader"   Color="#E8E8F0"/>

    <!-- Base TextBox style -->
    <Style x:Key="FieldBox" TargetType="TextBox">
        <Setter Property="Width" Value="90"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="2,1"/>
        <Setter Property="BorderBrush" Value="#AAAAAA"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Input field (white, enabled) -->
    <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
        <Setter Property="Background" Value="{StaticResource InputBrush}"/>
        <Setter Property="IsReadOnly" Value="False"/>
    </Style>

    <!-- Calculated field (light gray, read-only) -->
    <Style x:Key="CalcBox" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
        <Setter Property="Background" Value="{StaticResource CalcBrush}"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Foreground" Value="#444444"/>
    </Style>

    <!-- Reserved/locked field (medium gray, disabled, shows dash) -->
    <Style x:Key="LockedBox" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
        <Setter Property="Background" Value="{StaticResource LockedBrush}"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Foreground" Value="#777777"/>
    </Style>

    <!-- Unit label style -->
    <Style x:Key="UnitLabel" TargetType="TextBlock">
        <Setter Property="Width" Value="60"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#555555"/>
        <Setter Property="Margin" Value="3,0,0,0"/>
    </Style>

    <!-- Field name label -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Width" Value="160"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Group header label -->
    <Style x:Key="GroupLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#333366"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <!-- GroupBox style -->
    <Style TargetType="GroupBox">
        <Setter Property="Margin" Value="4,3,4,3"/>
        <Setter Property="Padding" Value="6,4,6,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#333366"/>
        <Setter Property="BorderBrush" Value="{StaticResource GroupBorder}"/>
    </Style>

    <!-- RadioButton style -->
    <Style TargetType="RadioButton">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <!-- Command button style -->
    <Style x:Key="CmdButton" TargetType="Button">
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="MinWidth" Value="110"/>
    </Style>

</ResourceDictionary>
